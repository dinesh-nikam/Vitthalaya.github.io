# Application Settings
APP_NAME=MusicIntelligencePlatform
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./music_intelligence.db
SYNC_DATABASE_URL=sqlite:///./music_intelligence.db
# For PostgreSQL production deployment:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/music_intelligence
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/music_intelligence

# Redis / Task Queue
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_QUEUE=false

# Scrapling Engine Settings
SCRAPLING_TIMEOUT=30
SCRAPLING_MAX_RETRIES=3
SCRAPLING_DEFAULT_WAIT=2.0
SCRAPLING_HEADLESS=true
SCRAPLING_STORAGE_DIR=./storage/scrapling_adaptive

# Rate Limiting & Robots.txt Compliance
ROBOTS_TXT_CACHE_TTL=86400
DEFAULT_DOMAIN_DELAY=2.0
USER_AGENT=MusicIntelligenceBot/1.0 (+https://github.com/example/music-intelligence; respectful musicological research)
