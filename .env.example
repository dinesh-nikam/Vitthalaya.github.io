# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL/CockroachDB connection string
DATABASE_URL=postgresql://user:password@host:26257/dbname?sslmode=verify-full

# ─── Authentication ───────────────────────────────────────────────────────────
# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AI Enrichment — Free LLM Provider ───────────────────────────────────────
# Pick ONE provider: groq | gemini | ollama | auto (default)
LLM_PROVIDER=auto

# Groq (recommended — fast, free)
GROQ_API_KEY=

# Google Gemini (free tier)
GEMINI_API_KEY=

# ─── Search ───────────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Payment (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── API Keys ─────────────────────────────────────────────────────────────────
# Scrape API key — generate with: openssl rand -hex 32
SCRAPE_API_KEY=

# Worker secret key — generate with: openssl rand -hex 32
WORKER_SECRET_KEY=

# ─── Monitoring (optional) ───────────────────────────────────────────────────
# Sentry DSN for error tracking
SENTRY_DSN=

# ─── OpenSearch (optional, future use) ────────────────────────────────────────
OPENSEARCH_URL=

# ─── Backup ───────────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
